#!/usr/bin/env python3
"""Fake nvidia-smi for ops tests: prints fixed CSV chosen by argv.

Leading --fake-gpu / --fake-apps options override the default CSV; lines are
separated by ';'. Any other invocation exits 2 like an unknown query.
"""
import sys

args = sys.argv[1:]
gpu = '49140, 9140'
apps = ''
while args and args[0] in ('--fake-gpu', '--fake-apps'):
    key = args.pop(0)
    value = args.pop(0)
    if key == '--fake-gpu':
        gpu = value
    else:
        apps = value
queries = [a for a in args if a.startswith('--query-')]
if queries and queries[0].startswith('--query-gpu='):
    print('\n'.join(gpu.split(';')))
elif queries and queries[0].startswith('--query-compute-apps='):
    if apps:
        print('\n'.join(apps.split(';')))
else:
    sys.exit(2)
